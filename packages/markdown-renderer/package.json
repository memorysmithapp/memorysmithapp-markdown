{
  "name": "@memorysmithapp/markdown-renderer",
  "version": "0.10.0",
  "description": "A React component that draws a MemorySmith note exactly as MemorySmith's reading page does.",
  "keywords": [
    "markdown",
    "react",
    "remark",
    "renderer",
    "wikilink",
    "callout",
    "katex",
    "mermaid",
    "memorysmith"
  ],
  "homepage": "https://github.com/memorysmithapp/memorysmithapp-markdown/tree/main/packages/markdown-renderer#readme",
  "bugs": {
    "url": "https://github.com/memorysmithapp/memorysmithapp-markdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memorysmithapp/memorysmithapp-markdown.git",
    "directory": "packages/markdown-renderer"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/edit/*.js",
    "dist/edit/*.d.ts",
    "styles.css",
    "structure.css",
    "theme-default.css",
    "LICENSE",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./diagnose": {
      "types": "./dist/diagnose.d.ts",
      "default": "./dist/diagnose.js"
    },
    "./edit": {
      "types": "./dist/edit/index.d.ts",
      "default": "./dist/edit/index.js"
    },
    "./styles.css": "./styles.css",
    "./structure.css": "./structure.css",
    "./theme-default.css": "./theme-default.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "cd ../.. && vitest run --project markdown-renderer"
  },
  "peerDependencies": {
    "katex": "^0.18.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "hast-util-to-jsx-runtime": "2.3.6",
    "mermaid": "11.17.0",
    "micromark-util-decode-string": "2.0.1",
    "react-markdown": "9.1.0",
    "refractor": "5.0.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@memorysmithapp/markdown-spec": "workspace:*",
    "@types/hast": "3.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "katex": "0.18.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
