{
  "name": "@memorysmithapp/markdown-spec",
  "version": "0.1.0",
  "description": "The MemorySmith Markdown Specification: the notation MemorySmith notebooks are written in, as a document, as data and as a conformance suite.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memorysmithapp/memorysmithapp-markdown.git",
