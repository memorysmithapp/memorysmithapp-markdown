{
  "name": "@memorysmithapp/markdown-spec",
  "version": "0.9.0",
  "description": "The MemorySmith Markdown Specification: the notation MemorySmith notebooks are written in, as a document, as data and as a conformance suite.",
  "keywords": [
    "markdown",
    "commonmark",
    "gfm",
    "specification",
    "conformance",
    "wikilink",
    "knowledge-management",
    "memorysmith"
  ],
  "homepage": "https://github.com/memorysmithapp/memorysmithapp-markdown/tree/main/packages/markdown-spec#readme",
  "bugs": {
    "url": "https://github.com/memorysmithapp/memorysmithapp-markdown/issues"
  },
  "license": "MIT AND CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memorysmithapp/memorysmithapp-markdown.git",
    "directory": "packages/markdown-spec"
  },
  "type": "module",
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "SPEC.md",
    "spec.json",
    "schema/spec.schema.json",
    "tests/conformance.json",
    "tests/README.md",
    "tools/check-spec.mjs",
    "LICENSE",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./spec.json": "./spec.json",
    "./conformance.json": "./tests/conformance.json",
    "./schema.json": "./schema/spec.schema.json",
    "./SPEC.md": "./SPEC.md"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node tools/check-spec.mjs && cd ../.. && vitest run --project markdown-spec",
    "check": "node tools/check-spec.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
