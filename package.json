{
  "name": "@memorysmithapp/markdown",
  "version": "0.3.0",
  "private": true,
  "description": "The MemorySmith Markdown Specification and a React renderer that draws a note as MemorySmith does.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memorysmithapp/memorysmithapp-markdown.git"
  },
  "scripts": {
    "quality": "node scripts/quality.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test \"scripts/**/*.test.mjs\" && pnpm -r build && pnpm -r test"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@12.11.2"
}
